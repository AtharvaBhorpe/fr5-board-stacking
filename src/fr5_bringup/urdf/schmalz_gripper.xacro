<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Schmalz electric cobot vacuum gripper (small), converted from the vendor STEP.
       Mesh frame: origin on the robot flange face, +z out of the flange toward the cup.
       Flange face -> relaxed cup tip: 103.4 mm. Body ~63 mm diameter, cup ~35 mm. -->
  <xacro:macro name="schmalz_gripper" params="parent yaw:=0.0 tcp_z:=0.1034">

    <joint name="gripper_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="gripper_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${yaw}"/>
    </joint>

    <link name="gripper_link">
      <visual>
        <geometry>
          <mesh filename="package://fr5_bringup/meshes/schmalz_gripper.stl"/>
        </geometry>
        <material name="schmalz_white"><color rgba="0.92 0.92 0.92 1"/></material>
      </visual>
      <!-- Simple shapes for collision checking. Body starts 3 mm off the flange
           so it never touches the robot's own wrist mesh. -->
      <collision>
        <origin xyz="0 0 ${0.003 + 0.0704 / 2}"/>
        <geometry><cylinder radius="0.032" length="0.0704"/></geometry>
      </collision>
      <collision>
        <origin xyz="0 0 ${0.0734 + 0.030 / 2}"/>
        <geometry><cylinder radius="0.018" length="0.030"/></geometry>
      </collision>
    </link>

    <!-- Tool centre point at the relaxed suction cup tip. Tune tcp_z on the real robot. -->
    <joint name="tcp_joint" type="fixed">
      <parent link="gripper_link"/>
      <child link="tcp"/>
      <origin xyz="0 0 ${tcp_z}" rpy="0 0 0"/>
    </joint>
    <link name="tcp"/>

  </xacro:macro>
</robot>

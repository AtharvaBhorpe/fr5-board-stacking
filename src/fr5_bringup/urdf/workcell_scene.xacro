<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Static workcell from config/workcell.yaml: table, profile,
       overhead camera frame and zone frames. The profile collision box
       has a 1 mm underside clearance; its physical top surface is preserved. -->

  <!-- Zone frame on the table surface, with a thin visual-only marker -->
  <xacro:macro name="workcell_zone" params="name x y yaw z rgba">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}"/>
    </joint>
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0.0005"/>
        <geometry><box size="0.30 0.23 0.001"/></geometry>
        <material name="${name}_color"><color rgba="${rgba}"/></material>
      </visual>
    </link>
  </xacro:macro>

  <xacro:macro name="workcell_scene" params="config_file">
    <xacro:property name="cfg" value="${xacro.load_yaml(config_file)}"/>
    <xacro:property name="t" value="${cfg['table']}"/>
    <xacro:property name="p" value="${cfg['profile']}"/>
    <xacro:property name="oc" value="${cfg['overhead_camera']}"/>
    <xacro:property name="sp" value="${cfg['robot_spacer']}"/>
    <xacro:property name="gap" value="0.001"/>
    <xacro:property name="profile_h" value="${p['height']}"/>

    <!-- Table top slab: its surface is at top_z -->
    <joint name="table_joint" type="fixed">
      <parent link="base_link"/>
      <child link="table"/>
      <origin xyz="${t['center_xy'][0]} ${t['center_xy'][1]} ${t['top_z'] - t['size'][2] / 2}"/>
    </joint>
    <link name="table">
      <visual>
        <geometry><box size="${t['size'][0]} ${t['size'][1]} ${t['size'][2]}"/></geometry>
        <material name="table_black"><color rgba="0.15 0.15 0.15 1"/></material>
      </visual>
      <collision>
        <geometry><box size="${t['size'][0]} ${t['size'][1]} ${t['size'][2]}"/></geometry>
      </collision>
    </link>

    <!-- Physical profile rests on the table; link origin is its centre. -->
    <joint name="profile_joint" type="fixed">
      <parent link="base_link"/>
      <child link="profile"/>
      <origin xyz="${p['center_xy'][0]} ${p['center_xy'][1]} ${t['top_z'] + profile_h / 2}"/>
    </joint>
    <link name="profile">
      <visual>
        <geometry><box size="${p['size_xy'][0]} ${p['size_xy'][1]} ${profile_h}"/></geometry>
        <material name="aluminium"><color rgba="0.75 0.75 0.78 1"/></material>
      </visual>
      <collision>
        <!-- Remove clearance from the underside only. -->
        <origin xyz="0 0 ${gap / 2}"/>
        <geometry><box size="${p['size_xy'][0]} ${p['size_xy'][1]} ${profile_h - gap}"/></geometry>
      </collision>
    </link>

    <!-- Measured mounting spacer; visual faces meet profile and robot base. -->
    <joint name="robot_spacer_joint" type="fixed">
      <parent link="base_link"/>
      <child link="robot_spacer"/>
      <origin xyz="${sp['center_xy'][0]} ${sp['center_xy'][1]} ${sp['top_z'] - sp['size'][2] / 2}"/>
    </joint>
    <link name="robot_spacer">
      <visual>
        <geometry>
          <box size="${sp['size'][0]} ${sp['size'][1]} ${sp['size'][2]}"/>
        </geometry>
        <material name="spacer_aluminium">
          <color rgba="0.65 0.65 0.68 1"/>
        </material>
      </visual>
      <collision>
        <!-- Deliberate 1 mm clearance at each fixed mounting face. -->
        <geometry>
          <box size="${sp['size'][0]} ${sp['size'][1]} ${sp['size'][2] - 2 * gap}"/>
        </geometry>
      </collision>
    </link>

    <!-- Overhead camera frame (approximate; replaced by extrinsic calibration) -->
    <joint name="overhead_camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="overhead_camera_link"/>
      <origin xyz="${oc['xy'][0]} ${oc['xy'][1]} ${t['top_z'] + oc['height_above_table']}"
              rpy="${oc['rpy'][0]} ${oc['rpy'][1]} ${oc['rpy'][2]}"/>
    </joint>
    <link name="overhead_camera_link"/>

    <xacro:workcell_zone name="pick_zone"
        x="${cfg['pick_zone']['center_xy'][0]}" y="${cfg['pick_zone']['center_xy'][1]}"
        yaw="${cfg['pick_zone']['yaw']}" z="${t['top_z']}" rgba="0.1 0.8 0.2 0.5"/>
    <xacro:workcell_zone name="place_zone"
        x="${cfg['place_zone']['center_xy'][0]}" y="${cfg['place_zone']['center_xy'][1]}"
        yaw="${cfg['place_zone']['yaw']}" z="${t['top_z']}" rgba="0.95 0.85 0.1 0.5"/>
  </xacro:macro>
</robot>

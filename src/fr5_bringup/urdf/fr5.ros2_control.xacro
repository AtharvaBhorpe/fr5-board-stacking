<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="fr5_joint" params="jname initial">
    <joint name="${jname}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <xacro:macro name="fr5_ros2_control" params="name use_fake_hardware initial_positions_file">
    <xacro:property name="init" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_fake_hardware}">
          <plugin>fairino_hardware/FairinoHardwareInterface</plugin>
        </xacro:unless>
      </hardware>
      <xacro:fr5_joint jname="j1" initial="${init['j1']}"/>
      <xacro:fr5_joint jname="j2" initial="${init['j2']}"/>
      <xacro:fr5_joint jname="j3" initial="${init['j3']}"/>
      <xacro:fr5_joint jname="j4" initial="${init['j4']}"/>
      <xacro:fr5_joint jname="j5" initial="${init['j5']}"/>
      <xacro:fr5_joint jname="j6" initial="${init['j6']}"/>
    </ros2_control>
  </xacro:macro>
</robot>

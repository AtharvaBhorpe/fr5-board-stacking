<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 3D-printed D405 wrist mount, sandwiched between the robot flange and the gripper.
       Mesh frame: origin on the robot flange face, +z toward the cup, +x along the camera arm.
       Plate stack (robot face -> gripper face): 9.5 mm.
       Arm end is tilted 8 deg: the D405 looks down and slightly toward the cup.
       Collision shapes keep >= 1 mm gaps to neighbouring links. -->
  <xacro:macro name="d405_wrist_mount" params="parent yaw:=0.0">

    <joint name="camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_mount_link"/>
      <origin xyz="0 0 0" rpy="0 0 ${yaw}"/>
    </joint>

    <link name="camera_mount_link">
      <visual>
        <geometry>
          <mesh filename="package://fr5_bringup/meshes/d405_wrist_mount.stl"/>
        </geometry>
        <material name="pla_beige"><color rgba="0.85 0.80 0.65 1"/></material>
      </visual>
      <!-- Ring between flange and gripper -->
      <collision>
        <origin xyz="0 0 ${0.0095 / 2}"/>
        <geometry><cylinder radius="0.0375" length="0.0095"/></geometry>
      </collision>
      <!-- Camera arm (6 mm thick, sloping 8 deg) -->
      <collision>
        <origin xyz="0.070 0 0.0075" rpy="0 -0.1396 0"/>
        <geometry><box size="0.060 0.042 0.006"/></geometry>
      </collision>
    </link>

    <!-- D405 body (42 x 42 x 23 mm), back face on the tilted arm end. Approximate. -->
    <joint name="wrist_camera_body_joint" type="fixed">
      <parent link="camera_mount_link"/>
      <child link="wrist_camera_body"/>
      <origin xyz="0.0869 0 0.0256" rpy="0 -0.1396 0"/>
    </joint>
    <link name="wrist_camera_body">
      <visual>
        <geometry><box size="0.042 0.042 0.023"/></geometry>
        <material name="d405_grey"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <collision>
        <geometry><box size="0.042 0.042 0.023"/></geometry>
      </collision>
    </link>

    <!-- Viewing frame at the front face (RealSense camera_link convention: x = viewing
         direction). Approximate: replace with the hand-eye calibration result. -->
    <joint name="wrist_camera_joint" type="fixed">
      <parent link="wrist_camera_body"/>
      <child link="wrist_camera_link"/>
      <origin xyz="0 0 0.0115" rpy="0 ${-pi / 2} 0"/>
    </joint>
    <link name="wrist_camera_link"/>

  </xacro:macro>
</robot>

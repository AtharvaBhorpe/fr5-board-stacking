<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeversion="1.0"?>
<package format="3">
  <name>hk_fr5_task_interfaces</name>
  <version>0.1.0</version>
  <description>Interfaces of the hk_fr5 main control loop: World / Board / Zone / Obstacle / Job / SkillCode messages, Pick / Place / Home / WaitClear / ReleaseSafe skill actions, AddJob / ListJobs / Control services.</description>
  <maintainer email="69069296+vortexcv@users.noreply.github.com">vortexcv</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeversion="1.0"?>
<package format="3">
  <name>hk_fr5_vision</name>
  <version>0.1.0</version>
  <description>hk_fr5 vision: camera pixel -> table x / y in base_link (homography calibration, vision_transform node).</description>
  <maintainer email="69069296+vortexcv@users.noreply.github.com">vortexcv</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>hk_fr5_vision_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0" encoding="UTF-8"?>
<robot name="hk_fr5">

  <!-- Planning group: all targets are for tcp (F2/F3) -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>

  <!-- Named poses (radians) -->
  <group_state name="zero" group="arm">
    <joint name="j1" value="0"/>
    <joint name="j2" value="0"/>
    <joint name="j3" value="0"/>
    <joint name="j4" value="0"/>
    <joint name="j5" value="0"/>
    <joint name="j6" value="0"/>
  </group_state>
  <!-- tcp pointing down at about (-0.50, -0.10, 0.36) m -->
  <group_state name="ready" group="arm">
    <joint name="j1" value="0"/>
    <joint name="j2" value="-1.570796"/>
    <joint name="j3" value="1.570796"/>
    <joint name="j4" value="-1.570796"/>
    <joint name="j5" value="-1.570796"/>
    <joint name="j6" value="0"/>
  </group_state>

  <!-- Arm pairs: from Fairino fairino5_v6_robot.srdf (MSA-generated) -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="upperarm_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist1_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="wrist1_link" reason="Never"/>
  <disable_collisions link1="upperarm_link" link2="wrist1_link" reason="Never"/>
  <disable_collisions link1="wrist1_link" link2="wrist2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist1_link" link2="wrist3_link" reason="Never"/>
  <disable_collisions link1="wrist2_link" link2="wrist3_link" reason="Adjacent"/>

  <!-- Tool pairs: rigidly fixed to each other (wrist3 + tool stack never move relative) -->
  <disable_collisions link1="wrist3_link" link2="d405_mount_link" reason="Adjacent"/>
  <disable_collisions link1="d405_mount_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="d405_mount_link" link2="d405_link" reason="Adjacent"/>
  <disable_collisions link1="wrist3_link" link2="gripper_link" reason="Never"/>
  <disable_collisions link1="wrist3_link" link2="d405_link" reason="Never"/>
  <disable_collisions link1="d405_link" link2="gripper_link" reason="Never"/>
  <!-- wrist1/wrist2 vs tool links stay checked: j5/j6 move them relative to each other -->
</robot>

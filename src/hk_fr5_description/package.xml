  <version>0.1.0</version>
  <description>FR5 + D405 wrist mount + Schmalz vacuum gripper + tcp (URDF/xacro, meshes).</description>
  <maintainer email="69069296+vortexcv@users.noreply.github.com">vortexcv</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fairino_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
